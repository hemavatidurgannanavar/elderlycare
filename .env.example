# CareCircle Custom Domain & Service Configuration
NEXT_PUBLIC_APP_URL=https://app.carecircle.health
NEXT_PUBLIC_APP_DOMAIN=carecircle.health

# Firebase Client Configuration (Production)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=app.carecircle.health
NEXT_PUBLIC_FIREBASE_PROJECT_ID=carecircle-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=carecircle-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Notification Service (SendGrid or AWS SES)
EMAIL_SERVICE_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
NOTIFICATION_FROM_EMAIL=alerts@carecircle.health

# Cron & Missed Dose Evaluation Secret
CRON_SECRET_KEY=your-secure-cron-secret
